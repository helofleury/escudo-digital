
{
  "expo": {
    "name": "Escudo Digital",
    "slug": "escudo-digital",
    "scheme": "escudodigital",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F0FF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.escudodigital.app"
    },
    "android": {
      "package": "br.com.escudodigital.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B45D6"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#5B45D6"
        }
      ]
    ]
  }
}
